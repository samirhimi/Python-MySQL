# Ignore SQL files that are not needed in the container
*.sql

# Ignore local virtual environments
venv/
.venv/
ENV/

# Ignore build artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyi
pip-wheel-metadata/
*.egg-info/
build/
dist/

# Ignore environment files and secrets
.env
.env.*

# Ignore Docker build artifacts
Dockerfile
.dockerignore

# Ignore git metadata
.git
.gitignore

# Ignore editor files
.vscode/
.idea/
*.swp
*~

# Ignore test and coverage artifacts
.pytest_cache/
htmlcov/
.coverage

# Ignore OS-generated files
.DS_Store
Thumbs.db
